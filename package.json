{
  "name": "clubscore-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ClubScore Live \u2014 \u0432\u044b\u0441\u043e\u043a\u043e\u0442\u0435\u0445\u043d\u043e\u043b\u043e\u0433\u0438\u0447\u043d\u044b\u0439 live-\u0441\u043a\u043e\u0440\u0438\u043d\u0433 \u0434\u043b\u044f \u0433\u043e\u043b\u044c\u0444-\u043a\u043b\u0443\u0431\u0430 (\u043c\u043e\u043d\u043e\u0440\u0435\u043f\u043e, 3 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u0430 \u00d7 5 \u0434\u0438\u0437\u0430\u0439\u043d\u043e\u0432)",
  "workspaces": [
    "packages/*",
    "apps/scoring",
    "apps/server",
    "apps/variant-a-core/*",
    "apps/variant-b-tournament/*",
    "apps/variant-c-experimental/*"
  ],
  "scripts": {
    "build:tokens": "node scripts/build-themes.mjs",
    "build": "npm run build:tokens && node scripts/build-all-apps.mjs && npm run build -w @csl/scoring-app",
    "build:server": "echo server is TS-run via tsx; typecheck covers it",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "node scripts/check-boundaries.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:all": "npm run lint && npm run typecheck && npm run test && npm run check:contrast",
    "server": "tsx apps/server/src/main.ts",
    "preview": "node scripts/serve-pages.mjs",
    "sim": "node scripts/sim-tournament.mjs"
  },
  "devDependencies": {
    "@fastify/cors": "^9.0.1",
    "@fontsource/comfortaa": "^5.1.0",
    "@fontsource/exo-2": "^5.1.0",
    "@fontsource/ibm-plex-sans": "^5.1.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/jetbrains-mono": "^5.1.0",
    "@fontsource/manrope": "^5.1.0",
    "@fontsource/nunito": "^5.1.0",
    "@fontsource/oswald": "^5.1.0",
    "@fontsource/playfair-display": "^5.1.0",
    "@fontsource/roboto-condensed": "^5.1.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.16",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "dexie": "^4.0.10",
    "fake-indexeddb": "^6.0.0",
    "fastify": "^4.28.1",
    "i18next": "^23.16.8",
    "immer": "^10.1.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.2.0",
    "react-router-dom": "^6.30.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "zod": "^3.24.1",
    "zustand": "^4.5.5"
  },
  "engines": {
    "node": ">=20"
  }
}